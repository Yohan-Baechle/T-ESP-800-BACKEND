# Configuration INFIRMO backend — copier vers .env et renseigner.
# Ne jamais committer le .env réel (secrets).

# Application
APP_NAME="INFIRMO API"
API_V1_PREFIX="/api/v1"
DEBUG=false

# Base de données PostgreSQL
DATABASE_URL="postgresql+psycopg://infirmo:infirmo@localhost:5432/infirmo"

# Redis (WebSocket pub/sub)
REDIS_URL="redis://localhost:6379/0"

# Sécurité / JWT
JWT_SECRET_KEY="change-me"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Chiffrement des données de santé au repos (clé AES-256 en base64, 32 octets)
# Générer une vraie clé : python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY="change-me-base64-32-bytes"
